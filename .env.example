# WalletConnect project id for the RainbowKit connect-and-send flow.
# Without it, only injected wallets (MetaMask etc.) are offered, which is fine.
VITE_WC_PROJECT_ID=

# The single donation wallet address used on every supported network.
# MUST be a valid 0x EVM address before this page goes live.
VITE_DONATION_ADDRESS=0x000000000000000000000000000000000000dEaD
