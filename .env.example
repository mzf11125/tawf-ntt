# WalletConnect project id for the RainbowKit connect-and-send flow.
# Without it, only injected wallets (MetaMask etc.) are offered, which is fine.
VITE_WC_PROJECT_ID=

# Optional override for the donation wallet address.
# Defaults to the Tawf × Telaga Charity multisig baked into src/lib/config.ts.
# Only set this if the wallet needs to change for a given build.
# VITE_DONATION_ADDRESS=0x...
